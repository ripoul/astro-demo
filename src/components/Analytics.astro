---
// Rendu uniquement quand PUBLIC_GA_ID est défini (voir BaseLayout.astro) : le
// script n'est chargé qu'après consentement, via l'évènement de CookieConsent.astro.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<script is:inline define:vars={{ gaId }}>
  let loaded = false;

  function loadAnalytics() {
    if (loaded) return;
    loaded = true;

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', gaId);
  }

  if (localStorage.getItem('cookie-consent') === 'granted') {
    loadAnalytics();
  }

  window.addEventListener('cookie-consent-changed', (event) => {
    if (event.detail === 'granted') loadAnalytics();
  });
</script>
