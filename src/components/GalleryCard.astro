---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  description: string;
  date: Date;
  fullSrc: string;
}

const { image, alt, description, date, fullSrc } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<button
  type="button"
  class="gallery-item"
  data-full-src={fullSrc}
  data-alt={alt}
  data-description={description}
  data-date={date.toISOString()}
  data-date-label={formattedDate}
>
  <Image src={image} alt={alt} width={500} class="gallery-item__image" />
</button>

<style>
  .gallery-item {
    display: block;
    width: 100%;
    margin: 0 0 0.75rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
  }

  .gallery-item :global(.gallery-item__image) {
    display: block;
    width: 100%;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover :global(.gallery-item__image) {
    transform: scale(1.04);
  }
</style>
